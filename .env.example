# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` al repositorio.

# --- Telegram ---
# Token de @BotFather
TELEGRAM_BOT_TOKEN=123456:ABCDEF_your_bot_token_here
# IDs numéricos de Telegram separados por coma (solo estos usuarios pueden usar el bot)
ALLOWED_USER_IDS=111111111,222222222
# Subconjunto de ALLOWED_USER_IDS que pueden usar /reindex
ADMIN_USER_IDS=111111111

# --- Modelo de lenguaje (API compatible con OpenAI) ---
# Valores típicos: openai, groq, openrouter, etc. (etiqueta libre para logs)
LLM_PROVIDER=openai
# Modelo según el proveedor (gpt-4o-mini, llama-3.3-70b-versatile, etc.)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...
# Opcional: URL base si usas Groq, OpenRouter u otro (OpenAI por defecto si se omite)
# LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900

# --- Embeddings ---
# openai: usa la API del proveedor (requiere EMBEDDING_API_KEY o reutiliza LLM_API_KEY si coincide)
# local: sentence-transformers en este equipo (sin API de embeddings)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Solo si EMBEDDING_PROVIDER=openai y la clave difiere de LLM_API_KEY
# EMBEDDING_API_KEY=sk-...
# ENDPOINT opcional para embeddings OpenAI-compatible
# EMBEDDING_BASE_URL=

# --- Rutas (opcional; por defecto igual que config.yaml) ---
# KNOWLEDGE_BASE_PATH=./knowledge_base
# SYSTEM_PROMPT_PATH=./prompts/system_prompt.md

# --- Parámetros RAG / tuning (opcional; si se omiten se usan los de config.yaml) ---
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# RETRIEVAL_TOP_K=5
# SIMILARITY_THRESHOLD=0.32
# HISTORY_LENGTH=12
# RATE_LIMIT_PER_MINUTE=20

# --- Seguridad / logs ---
LOG_LEVEL=INFO
